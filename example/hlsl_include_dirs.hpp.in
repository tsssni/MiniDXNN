#ifndef MINIDXNN_HLSL_INCLUDE_DIRS_HPP
#define MINIDXNN_HLSL_INCLUDE_DIRS_HPP 1

// Standard C++ library
#include <array>
#include <filesystem>
// 
#include "common/utility.hpp"

namespace ex {

inline
auto getHlslIncludeDirList() noexcept -> std::array<OptionString, 2>
{
  const std::array dirList = std::to_array<OptionString>({
      createOptionString("@mininn_dxc_include_dir@"),
      createOptionString("@mininn_mlp_include_dir@"),
  });
  return dirList;
}

inline
auto getComputeShaderDir() noexcept -> std::filesystem::path
{
  return std::filesystem::path{"@mininn_compute_shader_dir@"};
}

} /* namespace ex */

#endif /* MINIDXNN_HLSL_INCLUDE_DIRS_HPP */
